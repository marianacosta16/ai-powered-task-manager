# Copy to .env (not versioned) and fill in. Used by compose.yaml, which refuses to start while a required value is empty.
# There is no default on purpose: a password that is in the repository is a password everybody knows.
# DB_PASSWORD: the password of the database. DEMO_PASSWORD: the password of the 10 demo accounts (at least 8 characters).
DB_PASSWORD=
DEMO_PASSWORD=

# Optional (the values below are the defaults)
# DB_USER=matriz
# DB_NAME=matriz
# WEB_HTTP_PORT=8080     # use 80 where it is free
# WEB_HTTPS_PORT=8443    # use 443 where it is free
