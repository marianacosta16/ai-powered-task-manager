# Port 80 only sends the visitor to HTTPS. ${PUBLIC_HTTPS_PORT} is the port the visitor reaches HTTPS on (443 unless
# the container is published on another one), so that the redirect keeps the port.
server {
    listen 80;
    server_name _;
    return 301 https://$host:${PUBLIC_HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    server_name _;

    ssl_certificate     /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Docker's own DNS, asked again every 10 seconds, so that nginx follows the API when its container is recreated
    # (a fixed host name in proxy_pass would be resolved only once, when nginx starts)
    resolver ${DNS_RESOLVER} valid=10s;

    # A location that sets its own add_header does NOT inherit the ones of the server, so the security headers are
    # repeated in each location below that serves the interface.
    root /usr/share/nginx/html;

    # The API: /api/projects becomes /projects for the backend
    # (the API sends its own security headers, so none are added here)
    location /api/ {
        set $upstream ${API_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $upstream;
        proxy_set_header Host $http_host;
        # The API does not read this header (the session cookie is Secure because compose sets
        # SERVER_SERVLET_SESSION_COOKIE_SECURE); it is here for whatever sits behind the API.
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Files with a hash in the name never change
    location /assets/ {
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy same-origin always;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Any other address is a page of the interface (the router decides), so index.html is sent and never cached
    location / {
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy same-origin always;
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
