# Port 80 only sends the visitor to HTTPS
server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name _;

    ssl_certificate     /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    root /usr/share/nginx/html;

    # The API: /api/projects becomes /projects for the backend
    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Files with a hash in the name never change
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Any other address is a page of the interface (the router decides), so index.html is sent and never cached
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
