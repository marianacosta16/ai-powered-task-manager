# Copy to .env and fill in. .env is NOT versioned. All values below are fake.

# Development database
DB_URL=jdbc:postgresql://localhost:5432/matriz
DB_USER=matriz_app
DB_PASSWORD=change-me

# Test database (separate from development)
TEST_DB_URL=jdbc:postgresql://localhost:5432/matriz_test
TEST_DB_USER=matriz_app
TEST_DB_PASSWORD=change-me

# Password given to the 10 demo accounts (stored hashed)
DEMO_PASSWORD=change-me-demo

# Origins of the web interface that may call the API from a browser (exact, comma separated; no *)
CORS_ALLOWED_ORIGINS=http://localhost:5173
